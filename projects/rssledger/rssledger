#!/usr/bin/env python3
"""rssledger - a local-first, offline-friendly RSS/Atom reader."""

import argparse
import hashlib
import json
import os
import re
import sys
import tempfile
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET

VERSION = "0.1.0"
DEFAULT_DB = os.path.expanduser("~/.local/share/rssledger/state.json")


# ---------------------------------------------------------------------------
# Feed parsing
# ---------------------------------------------------------------------------

def local_name(tag):
    """Return an XML tag without its namespace, e.g. '{ns}title' -> 'title'."""
    return tag.rsplit("}", 1)[-1] if "}" in tag else tag


def node_text(node):
    return "".join(node.itertext()).strip() if node is not None else ""


def child(node, name):
    for candidate in list(node):
        if local_name(candidate.tag) == name:
            return candidate
    return None


def children(node, name):
    return [c for c in list(node) if local_name(c.tag) == name]


def atom_link(entry):
    links = children(entry, "link")
    for link in links:
        if link.get("rel", "alternate") == "alternate" and link.get("href"):
            return link.get("href")
    return links[0].get("href", "") if links and links[0].get("href") else ""


def parse_feed(data):
    """Parse RSS 2.0 or Atom bytes into (metadata, items). None on bad input."""
    try:
        root = ET.fromstring(data)
    except (ET.ParseError, ValueError, TypeError):
        return None
    root_name = local_name(root.tag)
    if root_name == "rss":
        channel = child(root, "channel")
        if channel is None:
            return None
        meta = {
            "title": node_text(child(channel, "title")),
            "link": node_text(child(channel, "link")),
            "description": node_text(child(channel, "description")),
        }
        entries = children(channel, "item")
        get_link = lambda item: node_text(child(item, "link"))
        get_summary = lambda item: node_text(child(item, "description"))
        get_date = lambda item: node_text(child(item, "pubDate"))
    elif root_name == "feed":
        meta = {
            "title": node_text(child(root, "title")),
            "link": atom_link(root),
            "description": node_text(child(root, "subtitle")),
        }
        entries = children(root, "entry")
        get_link = atom_link
        get_summary = lambda item: (
            node_text(child(item, "summary")) or node_text(child(item, "content"))
        )
        get_date = lambda item: (
            node_text(child(item, "updated")) or node_text(child(item, "published"))
        )
    else:
        return None

    items = []
    for entry in entries:
        items.append({
            "title": node_text(child(entry, "title")),
            "link": get_link(entry),
            "summary": get_summary(entry),
            "date": get_date(entry),
        })
    return meta, items


# ---------------------------------------------------------------------------
# Identifiers, state, fetching
# ---------------------------------------------------------------------------

def feed_id(url):
    return hashlib.sha1(url.encode("utf-8")).hexdigest()[:12]


def make_item_id(url, link, title):
    key = url + "\0" + (link or title or "")
    return hashlib.sha1(key.encode("utf-8")).hexdigest()[:16]


def empty_state():
    return {"version": 1, "feeds": [], "items": []}


def load_state(path):
    if not os.path.exists(path):
        return empty_state()
    try:
        with open(path, encoding="utf-8") as handle:
            state = json.load(handle)
        if not isinstance(state, dict) or "feeds" not in state or "items" not in state:
            raise ValueError("unrecognised state file")
        return state
    except (OSError, ValueError) as exc:
        raise RuntimeError("cannot read state: %s" % exc) from exc


def save_state(path, state):
    parent = os.path.dirname(os.path.abspath(path))
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".rssledger-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def fetch_bytes(url, etag=None, last_modified=None, timeout=10):
    """Return (data, headers, not_modified). file:// never uses the network."""
    if url.startswith("file://"):
        path = urllib.request.url2pathname(url[len("file://"):])
        with open(path, "rb") as handle:
            return handle.read(), {}, False
    if not re.match(r"^https?://", url):
        raise ValueError("unsupported URL scheme: %s" % url)
    headers = {}
    if etag:
        headers["If-None-Match"] = etag
    if last_modified:
        headers["If-Modified-Since"] = last_modified
    request = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.read(), dict(response.headers.items()), False
    except urllib.error.HTTPError as exc:
        if exc.code == 304:
            return None, {}, True
        raise


def fetch_feed(feed, state, populate=True):
    """Fetch one feed. Returns (status, message) with status in ok/unchanged/error.

    With populate=False only the feed metadata is refreshed; items are left for
    an explicit `fetch` (used when subscribing).
    """
    try:
        data, headers, not_modified = fetch_bytes(
            feed["url"], feed.get("etag"), feed.get("last_modified")
        )
    except Exception as exc:  # network is optional; failures must be graceful
        return "error", "could not fetch %s: %s" % (feed["url"], exc)
    if not_modified:
        return "unchanged", ""
    digest = hashlib.sha256(data or b"").hexdigest()
    if data is None or digest == feed.get("content_hash"):
        return "unchanged", ""
    parsed = parse_feed(data)
    if parsed is None:
        return "error", "could not parse %s: malformed RSS/Atom feed" % feed["url"]
    meta, entries = parsed
    if meta["title"]:
        feed["title"] = meta["title"]
    if meta["link"]:
        feed["site_url"] = meta["link"]
    if not populate:
        return "ok", ""
    feed["content_hash"] = digest
    feed["etag"] = headers.get("Etag") or headers.get("ETag")
    feed["last_modified"] = headers.get("Last-Modified")
    for entry in entries:
        item_id = make_item_id(feed["url"], entry["link"], entry["title"])
        existing = next((i for i in state["items"] if i["id"] == item_id), None)
        if existing is None:
            state["items"].append({
                "id": item_id,
                "feed_id": feed["id"],
                "title": entry["title"],
                "link": entry["link"],
                "summary": entry["summary"],
                "date": entry["date"],
                "read": False,
            })
        else:
            existing.update({
                "title": entry["title"],
                "link": entry["link"],
                "summary": entry["summary"],
                "date": entry["date"],
            })
    return "ok", ""


def find_item(state, item_id):
    return next((i for i in state["items"] if i["id"] == item_id), None)


def find_feed(state, feed_id_value):
    return next((f for f in state["feeds"] if f["id"] == feed_id_value), None)


def item_line(state, item):
    feed = find_feed(state, item["feed_id"])
    title = feed["title"] if feed else item["feed_id"]
    return "%s  %s  [%s]" % (item["id"], item.get("title", ""), title)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_add(args, state, db):
    url = args.url
    if find_feed(state, feed_id(url)):
        print("Already subscribed: %s" % url)
        return 0
    feed = {"id": feed_id(url), "url": url, "title": url}
    state["feeds"].append(feed)
    save_state(db, state)
    status, message = fetch_feed(feed, state, populate=False)
    save_state(db, state)
    if status == "error":
        print("rssledger: warning: %s" % message, file=sys.stderr)
    print("Added feed %s: %s" % (feed["id"], feed["title"]))
    return 0


def cmd_remove(args, state, db):
    feed = find_feed(state, args.id)
    if feed is None:
        print("rssledger: no such feed: %s" % args.id, file=sys.stderr)
        return 1
    state["feeds"].remove(feed)
    state["items"] = [i for i in state["items"] if i["feed_id"] != args.id]
    save_state(db, state)
    print("Removed feed %s" % args.id)
    return 0


def cmd_list(args, state, db):
    if not state["feeds"]:
        print("No feeds.")
        return 0
    for feed in state["feeds"]:
        mine = [i for i in state["items"] if i["feed_id"] == feed["id"]]
        unread = sum(1 for i in mine if not i.get("read"))
        print("%s  %s  %s  (%d items, %d unread)" % (
            feed["id"], feed["title"], feed["url"], len(mine), unread))
    return 0


def cmd_fetch(args, state, db):
    feeds = [find_feed(state, args.id)] if args.id else list(state["feeds"])
    if args.id and feeds[0] is None:
        print("rssledger: no such feed: %s" % args.id, file=sys.stderr)
        return 1
    for feed in feeds:
        status, message = fetch_feed(feed, state)
        if status == "error":
            print("rssledger: warning: %s" % message, file=sys.stderr)
        elif status == "unchanged":
            print("Unchanged %s" % feed["id"])
        else:
            count = sum(1 for i in state["items"] if i["feed_id"] == feed["id"])
            print("Fetched %s: %d items total" % (feed["id"], count))
    save_state(db, state)
    return 0


def cmd_read(args, state, db):
    item = find_item(state, args.id)
    if item is None:
        print("rssledger: no such item: %s" % args.id, file=sys.stderr)
        return 1
    item["read"] = True
    save_state(db, state)
    print("Marked %s read" % args.id)
    return 0


def cmd_unread(args, state, db):
    if args.id:
        item = find_item(state, args.id)
        if item is None:
            print("rssledger: no such item: %s" % args.id, file=sys.stderr)
            return 1
        item["read"] = False
        save_state(db, state)
        print("Marked %s unread" % args.id)
        return 0
    pending = [i for i in state["items"] if not i.get("read")]
    if not pending:
        print("No unread items.")
        return 0
    for item in pending:
        print(item_line(state, item))
    return 0


def cmd_search(args, state, db):
    query = args.query.lower()
    matches = [i for i in state["items"] if query in (
        " ".join(str(i.get(k, "")) for k in ("title", "summary", "link"))
    ).lower()]
    if not matches:
        print("No matches.")
        return 0
    for item in matches:
        print(item_line(state, item))
    return 0


def cmd_import_opml(args, state, db):
    try:
        root = ET.parse(args.file).getroot()
    except (OSError, ET.ParseError) as exc:
        print("rssledger: cannot read OPML: %s" % exc, file=sys.stderr)
        return 1
    added = 0
    for outline in root.iter():
        if local_name(outline.tag) != "outline":
            continue
        url = outline.get("xmlUrl") or outline.get("xmlurl")
        if not url:
            continue
        fid = feed_id(url)
        if find_feed(state, fid):
            continue
        title = outline.get("title") or outline.get("text") or url
        state["feeds"].append({
            "id": fid, "url": url, "title": title,
            "htmlUrl": outline.get("htmlUrl", ""),
        })
        added += 1
    save_state(db, state)
    print("Imported %d feeds (%d new)" % (added, added))
    return 0


def cmd_export_opml(args, state, db):
    opml = ET.Element("opml", {"version": "2.0"})
    head = ET.SubElement(opml, "head")
    ET.SubElement(head, "title").text = "rssledger subscriptions"
    body = ET.SubElement(opml, "body")
    for feed in state["feeds"]:
        attrs = {
            "text": feed["title"], "title": feed["title"],
            "type": "rss", "xmlUrl": feed["url"],
        }
        if feed.get("htmlUrl"):
            attrs["htmlUrl"] = feed["htmlUrl"]
        ET.SubElement(body, "outline", attrs)
    ET.indent(opml, space="  ")
    parent = os.path.dirname(os.path.abspath(args.file))
    os.makedirs(parent, exist_ok=True)
    ET.ElementTree(opml).write(args.file, encoding="utf-8", xml_declaration=True)
    print("Exported %d feeds to %s" % (len(state["feeds"]), args.file))
    return 0


def cmd_stats(args, state, db):
    read = sum(1 for i in state["items"] if i.get("read"))
    print("Feeds: %d" % len(state["feeds"]))
    print("Items: %d" % len(state["items"]))
    print("Unread: %d" % (len(state["items"]) - read))
    print("Read: %d" % read)
    return 0


COMMANDS = {
    "add": cmd_add, "remove": cmd_remove, "list": cmd_list, "fetch": cmd_fetch,
    "read": cmd_read, "unread": cmd_unread, "search": cmd_search,
    "import-opml": cmd_import_opml, "export-opml": cmd_export_opml,
    "stats": cmd_stats,
}


def build_parser():
    parser = argparse.ArgumentParser(
        prog="rssledger", description="Local-first RSS/Atom reader")
    parser.add_argument("--version", action="version", version="rssledger " + VERSION)
    parser.add_argument("--db", metavar="PATH", help="state file location")

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--db", metavar="PATH", default=argparse.SUPPRESS,
                        help="state file location")
    subs = parser.add_subparsers(dest="command", required=True)
    specs = {
        "add": (("url",), "subscribe to a feed URL"),
        "remove": (("id",), "remove a feed and its items"),
        "list": ((), "list subscribed feeds"),
        "fetch": (("id",), "fetch all feeds or one feed by id"),
        "read": (("id",), "mark an item as read"),
        "unread": (("id",), "mark an item unread, or list unread items"),
        "search": (("query",), "search item titles and descriptions"),
        "import-opml": (("file",), "import subscriptions from OPML"),
        "export-opml": (("file",), "export subscriptions to OPML"),
        "stats": ((), "show collection statistics"),
    }
    for name, (positionals, help_text) in specs.items():
        sub = subs.add_parser(name, help=help_text, parents=[common])
        for pos in positionals:
            nargs = "?" if name in ("fetch", "unread") and pos == "id" else None
            sub.add_argument(pos, nargs=nargs, help=pos)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    db = getattr(args, "db", None) or os.environ.get("RSSLEDGER_DB") or DEFAULT_DB
    try:
        state = load_state(db)
    except RuntimeError as exc:
        print("rssledger: %s" % exc, file=sys.stderr)
        return 1
    return COMMANDS[args.command](args, state, db)


if __name__ == "__main__":
    sys.exit(main())
