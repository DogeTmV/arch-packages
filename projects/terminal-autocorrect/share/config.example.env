# Example configuration for terminal-autocorrect.
# Copy the values you want into ~/.config/fish/config.fish using `set -gx`.
# These are fish syntax examples at the bottom; the bare values are shown for
# reference. Nothing here is applied unless you copy it.

# Minimum uses before a cached command is trusted.
AC_CACHE_MIN_COUNT=1

# Cache freshness in seconds. 0 forces a rebuild on every shell start.
AC_CACHE_MAX_AGE=86400

# Set to 1 to stop automatic cache rebuilds (refresh manually instead).
AC_NO_AUTO_CACHE=0

# Directories searched for candidate commands (colon-separated).
# AC_SEARCH_PATH=/usr/local/bin:/usr/bin:/bin

# Additional names that may be auto-corrected to.
# AC_TRUST_EXTRA="mytool othertool"

# Additional names that must never be auto-corrected to.
# AC_NEVER_AUTO="deploy prod-deploy"

# Custom lists.
# AC_COMMON_FILE="$HOME/.config/my-common-commands.txt"
# AC_DANGEROUS_FILE="$HOME/.config/my-dangerous-commands.txt"

# Suggestion tuning.
AC_MAX_SUGGESTIONS=5
AC_MIN_LEN_FOR_D2=4

# Where external utilities are resolved from.
AC_SYSTEM_PATH=/usr/bin:/bin:/usr/sbin:/sbin

# --- fish equivalents -------------------------------------------------------
# set -gx AC_CACHE_MIN_COUNT 2
# set -gx AC_CACHE_MAX_AGE 3600
# set -gx AC_TRUST_EXTRA "mytool othertool"
# set -gx AC_NEVER_AUTO "deploy"
