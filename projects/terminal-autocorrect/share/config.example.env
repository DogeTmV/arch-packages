# Example configuration for terminal-autocorrect.
# Copy the values you want into ~/.config/fish/config.fish using `set -gx`.
# Nothing here is applied unless you copy it. Fish equivalents are at bottom.

# Minimum uses before a cached command is trusted.
AC_CACHE_MIN_COUNT=1

# Recent cache freshness in seconds. 0 forces a rebuild on every shell start.
AC_CACHE_MAX_AGE=86400

# Set to 1 to stop automatic cache/system-base refreshes (refresh manually).
AC_NO_AUTO_CACHE=0

# Whole-system discovery.
AC_DISCOVER_SYSTEM_COMMANDS=1
# AC_SYSTEM_COMMAND_DIRS=/usr/local/bin:/usr/bin:/bin
# AC_PACKAGE_FILE_LIST="$HOME/.config/package-files.txt"
# AC_FISH_FUNCTIONS_DIR="$HOME/.config/fish/functions"
# AC_FISH_COMPLETIONS_DIR="$HOME/.config/fish/completions"
AC_SYSTEM_COMMANDS_MAX_AGE=604800

# Usage ranking.
# AC_POPULAR_FILE="$HOME/.config/my-popular-commands.txt"
AC_MAX_SUGGEST_DIST=3
AC_MAX_SUGGESTIONS=8
AC_MIN_LEN_FOR_D2=4
AC_SIMILAR_PREFIX_LEN=2

# Directories searched for candidate commands (colon-separated).
# AC_SEARCH_PATH=/usr/local/bin:/usr/bin:/bin

# Additional names that may be auto-corrected to.
# AC_TRUST_EXTRA="mytool othertool"

# Additional names that must never be auto-corrected to.
# AC_NEVER_AUTO="deploy prod-deploy"

# Custom lists.
# AC_COMMON_FILE="$HOME/.config/my-common-commands.txt"
# AC_DANGEROUS_FILE="$HOME/.config/my-dangerous-commands.txt"

# Where external utilities are resolved from.
AC_SYSTEM_PATH=/usr/bin:/bin:/usr/sbin:/sbin

# --- fish equivalents -------------------------------------------------------
# set -gx AC_CACHE_MIN_COUNT 2
# set -gx AC_CACHE_MAX_AGE 3600
# set -gx AC_DISCOVER_SYSTEM_COMMANDS 0
# set -gx AC_SYSTEM_COMMAND_DIRS "/usr/bin:/bin"
# set -gx AC_SYSTEM_COMMANDS_MAX_AGE 3600
# set -gx AC_POPULAR_FILE "$HOME/.config/my-popular-commands.txt"
# set -gx AC_MAX_SUGGEST_DIST 2
# set -gx AC_MAX_SUGGESTIONS 5
# set -gx AC_TRUST_EXTRA "mytool othertool"
# set -gx AC_NEVER_AUTO "deploy"
