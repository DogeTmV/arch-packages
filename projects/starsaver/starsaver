#!/usr/bin/env python3
"""starsaver - deterministic ASCII screensavers for the terminal."""

import argparse
import math
import random
import sys
import time

VERSION = "0.1.0"
MODES = ("stars", "rain", "pipes")
COLORS = {"stars": "\x1b[36m", "rain": "\x1b[32m", "pipes": "\x1b[35m"}


class SaverError(Exception):
    """A user-facing error with no traceback."""


class Starfield:
    def __init__(self, rng, width, height):
        self.width, self.height = width, height
        count = max(8, width * height // 25)
        self.stars = [
            [rng.randrange(width), rng.randrange(height), rng.choice(".+*")]
            for _ in range(count)
        ]

    def frame(self):
        grid = [[" "] * self.width for _ in range(self.height)]
        for star in self.stars:
            grid[star[1]][star[0]] = star[2]
            star[1] = (star[1] + 1) % self.height
        return "\n".join("".join(row) for row in grid)


class Rain:
    GLYPHS = "01<>*+-:#"
    DIRECTIONS = ((1, 0), (-1, 0), (0, 1), (0, -1))

    def __init__(self, rng, width, height):
        self.rng, self.width, self.height = rng, width, height
        self.tick = 0
        self.columns = [
            {
                "head": rng.randrange(-height, height),
                "speed": rng.randint(1, 3),
                "head_char": rng.choice("@O#"),
                "glyphs": [rng.choice(self.GLYPHS) for _ in range(height)],
            }
            for _ in range(width)
        ]

    def frame(self):
        grid = [[" "] * self.width for _ in range(self.height)]
        for x, column in enumerate(self.columns):
            head = column["head"]
            for offset in range(self.height):
                y = head - offset
                if 0 <= y < self.height:
                    glyph = column["glyphs"][(y + self.tick) % self.height]
                    grid[y][x] = column["head_char"] if offset == 0 else glyph
            column["head"] += column["speed"]
            if column["head"] - self.height > self.height:
                column["head"] = self.rng.randrange(-self.height, 0)
        self.tick += 1
        return "\n".join("".join(row) for row in grid)


class Pipes:
    DIRECTIONS = ((1, 0), (-1, 0), (0, 1), (0, -1))

    def __init__(self, rng, width, height):
        self.rng, self.width, self.height = rng, width, height
        self.grid = [[" "] * width for _ in range(height)]
        self.x, self.y = rng.randrange(width), rng.randrange(height)
        self.dx, self.dy = rng.choice(self.DIRECTIONS)
        self.steps = 0

    def frame(self):
        for _ in range(max(2, self.width // 4)):
            nx, ny = self.x + self.dx, self.y + self.dy
            if not (0 <= nx < self.width and 0 <= ny < self.height) or self.grid[ny][nx] != " ":
                if self.steps % 5 == 0:
                    self.grid = [[" "] * self.width for _ in range(self.height)]
                self.dx, self.dy = self.rng.choice(self.DIRECTIONS)
                self.x, self.y = self.rng.randrange(self.width), self.rng.randrange(self.height)
                continue
            self.grid[self.y][self.x] = "-" if self.dx else "|"
            self.x, self.y = nx, ny
            self.grid[ny][nx] = "+"
            if self.rng.random() < 0.3:
                self.dx, self.dy = self.rng.choice(self.DIRECTIONS)
            self.steps += 1
        return "\n".join("".join(row) for row in self.grid)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="starsaver", description="Deterministic ASCII screensavers: stars, rain and pipes."
    )
    parser.add_argument("--version", action="version", version=f"starsaver {VERSION}")
    subs = parser.add_subparsers(dest="command", required=True)

    subs.add_parser("modes", help="list available screensaver modes")

    run = subs.add_parser("run", help="animate a screensaver in the terminal")
    run.add_argument("mode", choices=MODES)
    run.add_argument("--duration", type=float, default=5.0, metavar="N", help="seconds (default: 5)")
    run.add_argument("--fps", type=int, default=12, metavar="N", help="frames per second (default: 12)")
    run.add_argument("--seed", type=int, default=0, metavar="N", help="random seed")
    run.add_argument("--no-ansi", action="store_true", help="do not emit ANSI escapes")
    run.add_argument("--width", type=int, default=80, metavar="W")
    run.add_argument("--height", type=int, default=24, metavar="H")

    render = subs.add_parser("render", help="print deterministic ASCII frames")
    render.add_argument("mode", choices=MODES)
    render.add_argument("--frames", type=int, required=True, metavar="N")
    render.add_argument("--seed", type=int, required=True, metavar="N")
    render.add_argument("--width", type=int, default=80, metavar="W")
    render.add_argument("--height", type=int, default=24, metavar="H")
    return parser


def make_animation(mode, seed, width, height):
    if width < 5 or width > 400 or height < 3 or height > 200:
        raise SaverError(f"invalid size {width}x{height}; use width >= 5 and height >= 3")
    rng = random.Random(seed)
    if mode == "stars":
        return Starfield(rng, width, height)
    if mode == "rain":
        return Rain(rng, width, height)
    if mode == "pipes":
        return Pipes(rng, width, height)
    raise SaverError(f"unknown mode {mode!r}; choose from {', '.join(MODES)}")


def cmd_modes(args):
    for mode in MODES:
        print(mode)


def cmd_render(args):
    if args.frames < 1:
        raise SaverError("--frames must be a positive integer")
    animation = make_animation(args.mode, args.seed, args.width, args.height)
    print("\n\n".join(animation.frame() for _ in range(args.frames)))


def cmd_run(args):
    if args.duration < 0 or args.fps < 1:
        raise SaverError("--duration must be non-negative and --fps must be positive")
    animation = make_animation(args.mode, args.seed, args.width, args.height)
    frame_count = max(1, math.ceil(args.duration * args.fps))
    for index in range(frame_count):
        frame = animation.frame()
        if args.no_ansi:
            print(frame, flush=True)
        else:
            sys.stdout.write("\x1b[2J\x1b[H" + COLORS[args.mode] + frame + "\x1b[0m\n")
            sys.stdout.flush()
        if index + 1 < frame_count:
            time.sleep(1 / args.fps)


COMMANDS = {"modes": cmd_modes, "run": cmd_run, "render": cmd_render}


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        COMMANDS[args.command](args)
    except SaverError as exc:
        print(f"starsaver: error: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
