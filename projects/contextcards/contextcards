#!/usr/bin/env python3
"""contextcards - a local, quiet context dashboard digest.

An original reimplementation inspired by the discontinued Google Now.
Rules and imported local events are selected deterministically for a date.
"""

import argparse
import datetime as dt
import html
import json
import os
import sys
import tempfile

VERSION = "0.1.0"
DEFAULT_STATE = os.path.expanduser("~/.local/share/contextcards/state.json")
WEEKDAYS = ("MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN")
KINDS = ("calendar", "weather", "commute")


# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

def state_file(args=None):
    chosen = getattr(args, "dir", None)
    return os.path.join(chosen, "state.json") if chosen else DEFAULT_STATE


def empty_state():
    return {"version": 1, "rules": [], "events": []}


def load_state(path):
    if not os.path.exists(path):
        return empty_state()
    try:
        with open(path, encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, ValueError) as exc:
        raise RuntimeError("cannot read state %s: %s" % (path, exc)) from exc
    if (not isinstance(state, dict) or not isinstance(state.get("rules"), list)
            or not isinstance(state.get("events"), list)):
        raise RuntimeError("unrecognised state file: %s" % path)
    state.setdefault("version", 1)
    return state


def save_state(path, state):
    parent = os.path.dirname(os.path.abspath(path))
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".contextcards-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


# ---------------------------------------------------------------------------
# Validation and card selection
# ---------------------------------------------------------------------------

def as_text(value):
    return "" if value is None else str(value)


def check_date(value, label):
    value = as_text(value)
    if not value:
        return ""
    try:
        return dt.date.fromisoformat(value).isoformat()
    except ValueError as exc:
        raise RuntimeError("%s must be YYYY-MM-DD" % label) from exc


def check_weekday(value):
    value = as_text(value).strip().upper()
    if not value:
        return ""
    if value not in WEEKDAYS:
        raise RuntimeError("weekday must be one of %s" % ", ".join(WEEKDAYS))
    return value


def check_time(value):
    value = as_text(value)
    if not value:
        return ""
    try:
        return dt.datetime.strptime(value, "%H:%M").strftime("%H:%M")
    except ValueError as exc:
        raise RuntimeError("time must be HH:MM") from exc


def day_matches(item, day, weekday):
    return ((not item.get("date") or item["date"] == day)
            and (not item.get("weekday") or item["weekday"] == weekday))


def rule_matches(rule, day, weekday, active_events):
    if not day_matches(rule, day, weekday):
        return False
    tag = as_text(rule.get("tag")).casefold()
    if tag and not any(as_text(e.get("tag")).casefold() == tag
                       for e in active_events):
        return False
    return True


def card_sort_key(card):
    return (card.get("time") or "99:99", card["title"].casefold(),
            card["body"].casefold(), card["origin"])


def select_cards(state, day):
    weekday = dt.date.fromisoformat(day).strftime("%a").upper()
    active = [event for event in state["events"]
              if day_matches(event, day, weekday)]
    cards = []
    for index, event in enumerate(active):
        cards.append({
            "title": as_text(event.get("title")),
            "body": as_text(event.get("body")),
            "label": as_text(event.get("kind")) or "event",
            "time": as_text(event.get("time")),
            "origin": "event:%d" % index,
        })
    for rule in state["rules"]:
        if rule_matches(rule, day, weekday, active):
            cards.append({
                "title": as_text(rule.get("title")),
                "body": as_text(rule.get("body")),
                "label": as_text(rule.get("tag")) or "note",
                "time": "",
                "origin": "rule:" + as_text(rule.get("name")),
            })
    cards.sort(key=card_sort_key)
    return weekday, cards


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

def render_text(day, weekday, cards):
    lines = ["Context cards for %s (%s)" % (day, weekday), ""]
    if not cards:
        lines.append("Nothing scheduled.")
    for card in cards:
        prefix = card["time"] + "  " if card["time"] else ""
        lines.append("%s%s  [%s]" % (prefix, card["title"], card["label"]))
        if card["body"]:
            lines.append(" " * 7 + card["body"])
        lines.append("")
    lines.append("%d card%s." % (len(cards), "" if len(cards) == 1 else "s"))
    return "\n".join(lines) + "\n"


def render_html(day, weekday, cards):
    esc = lambda value: html.escape(as_text(value), quote=True)
    lines = [
        "<!DOCTYPE html>", '<html lang="en">', "<head>",
        '<meta charset="utf-8">', "<title>contextcards</title>", "</head>",
        "<body>",
        "<h1>Context cards for %s (%s)</h1>" % (esc(day), esc(weekday)),
        "<ul class=\"cards\">",
    ]
    for card in cards:
        stamp = "<time>%s</time> " % esc(card["time"]) if card["time"] else ""
        lines.append(
            '<li class="card">%s<strong>%s</strong> <em>[%s]</em>'
            % (stamp, esc(card["title"]), esc(card["label"])))
        if card["body"]:
            lines.append("<p>%s</p>" % esc(card["body"]))
        lines.append("</li>")
    lines.extend([
        "</ul>",
        "<p>%d card%s.</p>" % (len(cards), "" if len(cards) == 1 else "s"),
        "</body>", "</html>", "",
    ])
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_rule(args):
    path = state_file(args)
    state = load_state(path)
    rule = {
        "name": args.name,
        "title": args.title,
        "body": args.body,
        "date": check_date(args.date, "date"),
        "weekday": check_weekday(args.weekday),
        "tag": as_text(args.tag),
    }
    state["rules"] = [r for r in state["rules"]
                      if as_text(r.get("name")) != args.name] + [rule]
    save_state(path, state)
    print("Saved rule %s" % args.name)
    return 0


def cmd_list(args):
    state = load_state(state_file(args))
    print("Rules:")
    if not state["rules"]:
        print("  (none)")
    for rule in state["rules"]:
        conditions = ", ".join("%s=%s" % (key, rule[key])
                               for key in ("date", "weekday", "tag")
                               if as_text(rule.get(key)))
        print("  %s: %s%s" % (as_text(rule.get("name")),
                              as_text(rule.get("title")),
                              " [%s]" % conditions if conditions else ""))
    print("Events:")
    if not state["events"]:
        print("  (none)")
    for event in state["events"]:
        conditions = ", ".join("%s=%s" % (key, event[key])
                              for key in ("date", "weekday", "kind", "tag")
                              if as_text(event.get(key)))
        print("  %s: %s [%s]" % (as_text(event.get("kind")),
                                 as_text(event.get("title")), conditions))
    return 0


def cmd_rm(args):
    path = state_file(args)
    state = load_state(path)
    before = len(state["rules"])
    state["rules"] = [r for r in state["rules"]
                      if as_text(r.get("name")) != args.name]
    if len(state["rules"]) == before:
        raise RuntimeError("no such rule: %s" % args.name)
    save_state(path, state)
    print("Removed rule %s" % args.name)
    return 0


def cmd_feed(args):
    try:
        with open(args.infile, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError) as exc:
        raise RuntimeError("cannot read events: %s" % exc) from exc
    if isinstance(data, dict):
        entries = data.get("events", [])
    elif isinstance(data, list):
        entries = data
    else:
        entries = None
    if not isinstance(entries, list):
        raise RuntimeError("events JSON must be a list or an object with events")
    events = []
    for raw in entries:
        if not isinstance(raw, dict) or not as_text(raw.get("title")):
            raise RuntimeError("every event needs a title")
        kind = as_text(raw.get("kind")).lower()
        if kind not in KINDS:
            raise RuntimeError("event kind must be one of %s" % ", ".join(KINDS))
        events.append({
            "kind": kind,
            "title": as_text(raw["title"]),
            "body": as_text(raw.get("body")),
            "date": check_date(raw.get("date"), "event date"),
            "weekday": check_weekday(raw.get("weekday")),
            "tag": as_text(raw.get("tag")),
            "time": check_time(raw.get("time")),
        })
    path = state_file(args)
    state = load_state(path)
    state["events"] = events  # feeding replaces the previous local snapshot
    save_state(path, state)
    print("Imported %d local events" % len(events))
    return 0


def cmd_show(args):
    day = check_date(args.date, "date") or dt.date.today().isoformat()
    weekday, cards = select_cards(load_state(state_file(args)), day)
    rendered = render_html(day, weekday, cards) if args.format == "html" \
        else render_text(day, weekday, cards)
    print(rendered, end="")
    return 0


def cmd_export(args):
    state = load_state(state_file(args))
    parent = os.path.dirname(os.path.abspath(args.file))
    os.makedirs(parent, exist_ok=True)
    with open(args.file, "w", encoding="utf-8") as handle:
        json.dump(state, handle, indent=2, sort_keys=True)
        handle.write("\n")
    print("Exported %d rules and %d events to %s" % (
        len(state["rules"]), len(state["events"]), args.file))
    return 0


def cmd_import(args):
    try:
        with open(args.file, encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, ValueError) as exc:
        raise RuntimeError("cannot read import file: %s" % exc) from exc
    if (not isinstance(state, dict) or not isinstance(state.get("rules"), list)
            or not isinstance(state.get("events"), list)):
        raise RuntimeError("not a contextcards state file: %s" % args.file)
    save_state(state_file(args), state)
    print("Imported %d rules and %d events" % (
        len(state["rules"]), len(state["events"])))
    return 0


COMMANDS = {
    "rule": cmd_rule, "list": cmd_list, "rm": cmd_rm, "feed": cmd_feed,
    "show": cmd_show, "export": cmd_export, "import": cmd_import,
}


def build_parser():
    parser = argparse.ArgumentParser(
        prog="contextcards", description="Local context dashboard digest")
    parser.add_argument("--version", action="version",
                        version="contextcards " + VERSION)
    subs = parser.add_subparsers(dest="command", required=True)

    def sub(name, help_text):
        child = subs.add_parser(name, help=help_text)
        child.add_argument("--dir", metavar="PATH",
                           help="state directory")
        return child

    rule = sub("rule", "create or update a rule")
    rule.add_argument("name")
    rule.add_argument("--title", required=True)
    rule.add_argument("--body", required=True)
    rule.add_argument("--date", metavar="YYYY-MM-DD")
    rule.add_argument("--weekday", metavar="MON")
    rule.add_argument("--tag", metavar="TAG")

    sub("list", "list rules and imported events")
    remove = sub("rm", "remove a rule")
    remove.add_argument("name")
    feed = sub("feed", "import local events from JSON (never uses network)")
    feed.add_argument("infile", metavar="events.json")
    show = sub("show", "render a digest for a date")
    show.add_argument("--date", metavar="YYYY-MM-DD")
    show.add_argument("--format", choices=("text", "html"), default="text")
    export = sub("export", "export all state as JSON")
    export.add_argument("file", metavar="file.json")
    imported = sub("import", "replace all state from JSON")
    imported.add_argument("file", metavar="file.json")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return COMMANDS[args.command](args)
    except (RuntimeError, OSError, ValueError, KeyError) as exc:
        print("contextcards: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
