# Maintainer: DogeTmV
pkgname=lanbridge
pkgver=0.1.0
pkgrel=1
pkgdesc='LAN companion bridge between a Linux PC and Android phone (screen, commands, clipboard, files, media)'
arch=('any')
url='https://github.com/DogeTmV/arch-packages'
license=('MIT')
depends=('python' 'pyside6' 'qt6-svg')
optdepends=('playerctl: control PC media players via MPRIS')
source=("local-source.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$pkgname"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 core.py "$pkgdir/usr/lib/$pkgname/core.py"
  install -Dm644 server.py "$pkgdir/usr/lib/$pkgname/server.py"
  install -Dm644 gui.py "$pkgdir/usr/lib/$pkgname/gui.py"
  install -Dm644 theme.py "$pkgdir/usr/lib/$pkgname/theme.py"
  install -Dm644 "$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 icons/$pkgname.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 TUTORIAL.md "$pkgdir/usr/share/doc/$pkgname/TUTORIAL.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
